{
  "name": "@danielmeneses/pi-llama-swap",
  "version": "0.2.0",
  "description": "Pi extension: llama-swap provider with dynamic model discovery",
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "npm run lint && npm run test && tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "index.ts",
    "lib"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "main": "index.ts",
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmeneses/pi-llama-swap.git"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi"
  ],
  "author": "Daniel Meneses",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/danielmeneses/pi-llama-swap/issues"
  },
  "homepage": "https://github.com/danielmeneses/pi-llama-swap#readme"
}
